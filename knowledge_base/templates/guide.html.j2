{#- Układ przewodnika dev-agents (wzorzec: dev_log/guide_mockup.html).
    Dane przygotowuje render.py: project_name, project_root, generated_at, nav (zakładki do menu), tabs (zakładki
    z nagłówkiem, lead i sekcjami w kolejności z guide_template.yaml), cards (karty „jak czytać”), node_numbers
    (id klocka diagramu → numer), path_kind_labels (rodzaj ścieżki → napis), css, js.
    Każda sekcja ma state: content (blok z treścią), missing (zdanie missing_text, domyślnie „nie wynika z kodu”)
    albo pending (typ bloku dochodzi w kolejnym kroku planu). Dane z faktów kodu: tree (drzewo plików), code_text
    (treść bloku kodu, np. plików zależności), rows (wiersze tabeli; komórka ma opcjonalnie code i badge),
    flow (data: dane diagramu dla skryptu rysującego albo None, problems: lista problemów diagramu),
    graph (data: węzły i krawędzie grafu zależności dla skryptu rysującego albo None, isolated: pliki bez powiązań do
    wymienienia pod grafem, isolated_count: ich liczba razem), reading (entries: pliki kolejności czytania ze zdaniem
    pisarza, has_reasons: czy któryś plik ma zdanie).
    Filtr terms (glossary.py) oznacza w tekście terminy ze słowniczka (span.tm z data-t i data-d dla dymku) i zwraca
    bezpieczny HTML; stosujemy go tylko do tekstu od agentów, nie do kodu, nazw plików ani wartości konfiguracji.
    Escapowanie jest zawsze włączone - treść od agentów jest tekstem. -#}
{%- macro block_text(block) -%}
{%- for paragraph in block.paragraphs %}
 <p>{{ paragraph | terms }}</p>
{%- endfor %}
{%- endmacro -%}

{%- macro block_list(block) -%}
 <ul class="ul">
{%- for item in block.items %}
  <li>{{ item | terms }}</li>
{%- endfor %}
 </ul>
{%- endmacro -%}

{%- macro io_items(items) -%}
{%- for item in items %}
<p class="note"><code>{{ item.name }}</code>{% if item.description %} - {{ item.description | terms }}{% endif %}{% if item.location %} <span class="src"><code>{{ item.location }}</code></span>{% endif %}</p>
{%- endfor %}
{%- endmacro -%}

{%- macro block_io(block, core_title, core_text) -%}
 <div class="io">
  <div class="box"><h3>Wejście</h3>{{ io_items(block.inputs) }}</div>
  <div class="ar"></div>
  <div class="core"><b>{{ core_title }}</b><span>{{ core_text }}</span></div>
  <div class="ar"></div>
  <div class="box"><h3>Wyjście</h3>{{ io_items(block.outputs) }}</div>
 </div>
{%- endmacro -%}

{%- macro code_box(code) -%}
<div class="cb"><pre>{{ code }}</pre></div>
{%- endmacro -%}

{%- macro block_steps(block) -%}
 <ol class="road">
{%- for step in block.steps %}
  <li><b>{{ step.title }}</b>{% if step.text %}<span>{{ step.text | terms }}</span>{% endif %}
{%- if step.code %}
   {{ code_box(step.code) }}
{%- endif %}</li>
{%- endfor %}
 </ol>
{%- endmacro -%}

{%- macro block_table(columns, rows) -%}
 <div class="scroll"><table class="stack">
  <thead><tr>{% for column in columns %}<th>{{ column }}</th>{% endfor %}</tr></thead>
  <tbody>
{%- for row in rows %}
   <tr>{% for cell in row %}<td data-l="{{ cell.label }}">{% if cell.badge %}<span class="kv {{ cell.badge_color }}">{{ cell.badge }}</span> {% endif %}{% if cell.code %}<code>{{ cell.text }}</code>{% else %}{{ cell.text | terms }}{% endif %}{% if cell.uncertain %} <span class="unc">wywnioskowane</span>{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
  </tbody>
 </table></div>
{%- endmacro -%}

{%- macro block_glossary(block) -%}
 <dl class="gl">
{%- for term in block.terms %}
  <dt>{{ term.term }}</dt><dd>{{ term.definition }}</dd>
{%- endfor %}
 </dl>
{%- endmacro -%}

{%- macro block_paths(block, node_numbers, kind_labels) -%}
 <div class="paths">
{%- for path in block.paths %}
  <div class="path">
   <h3>{{ path.name }} <span class="tagr"{% if path.kind == "main" %} style="color:var(--ink);border-color:var(--ink)"{% endif %}>{{ kind_labels[path.kind] }}</span></h3>
   <ol class="pl">
{%- for step in path.steps %}
    <li>{{ step.text | terms }}{% if step.node_id in node_numbers %} <a class="ref" href="#przeplyw">{{ node_numbers[step.node_id] }}</a>{% endif %}</li>
{%- endfor %}
   </ol>
  </div>
{%- endfor %}
 </div>
{%- endmacro -%}

{%- macro block_recipes(block) -%}
{%- for recipe in block.recipes %}
 <div class="recipe">
  <h2>{{ recipe.title }}</h2>
  <p class="when">Kiedy: {{ recipe.when | terms }}</p>
{%- if recipe.files %}
  <div class="files">{% for file in recipe.files %}<span class="c{% if file.is_new %} new{% endif %}" title="{{ file.change }}">{{ file.path }}</span>{% endfor %}</div>
{%- endif %}
  <ol class="road">
{%- for step in recipe.steps %}
   <li>{{ step | terms }}</li>
{%- endfor %}
  </ol>
 </div>
{%- endfor %}
{%- endmacro -%}

{%- macro config_tile_entry(entry) -%}
{%- if entry.password %}
   <p>Hasło <code>{{ entry.value }}</code></p>
{%- elif entry.kind == "system" %}
   <p class="warn">{{ entry.value }}</p>
{%- elif entry.kind == "account" %}
   <p>Konto <code>{{ entry.value }}</code></p>
{%- elif entry.kind == "env_var" %}
   <p>Zmienna <code>{{ entry.value }}</code> <span class="kv r">ustaw przed uruchomieniem</span></p>
{%- elif entry.kind == "switch" %}
   <p><code>{{ entry.key }}</code> = <code>{{ entry.value }}</code></p>
{%- else %}
   <p><code>{{ entry.value }}</code></p>
{%- endif %}
{%- if entry.password %}
   <p><span class="kv r">{{ entry.password }}</span></p>
{%- endif %}
{%- if entry.kind != "switch" or entry.meaning %}
   <p class="src">{% if entry.kind != "switch" %}<code>{{ entry.label }}</code>{% if entry.meaning %} · {% endif %}{% endif %}{{ entry.meaning }}{% if entry.uncertain %} <span class="unc">wywnioskowane</span>{% endif %}</p>
{%- endif %}
{%- endmacro -%}

{%- macro config_row(entry) -%}
    <tr><td data-l="Klucz"><code>{{ entry.key }}</code></td><td class="val" data-l="Wartość"><code>{{ entry.value }}</code> {% if entry.password %}<span class="kv r">{{ entry.password }}</span>{% elif entry.badge_text %}<span class="kv {{ entry.badge_color }}">{{ entry.badge_text }}</span>{% endif %}</td><td data-l="Znaczenie">{{ entry.meaning }}{% if entry.uncertain %} <span class="unc">wywnioskowane</span>{% endif %}</td><td data-l="Używany w">{% for place in entry.places %}{% if not loop.first %}, {% endif %}<code>{{ place.text }}</code>{% if place.constant %} <span class="kv m">stała</span>{% endif %}{% endfor %}</td></tr>
{%- endmacro -%}

{%- macro block_config(config) -%}
 <p class="note">Wartości przepisane z pliku konfiguracyjnego robota (narzędzie przekazuje plik bez zmian) i ze stałych w kodzie; znaczenie kluczy i miejsca użycia opisuje agent na podstawie kodu. Niczego nie ukrywamy: hasło wpisane wprost w plik albo w kod jest pokazane, oznaczone na czerwono i trafia do „Ryzykownych miejsc” w zakładce Błędy i naprawa.</p>
 <div class="pp">
  <div class="pp-h"><b>{{ config.header }}</b>{% if config.sentence %}<span>{{ config.sentence }}</span>{% endif %}</div>
  <div class="pp-g">
{%- for tile in config.tiles %}
   <div><h3>{{ tile.title }}</h3>
{%- for entry in tile.entries %}
{{ config_tile_entry(entry) }}
{%- endfor %}
   </div>
{%- endfor %}
  </div>
 </div>
 <details class="cfg">
  <summary>Pełna konfiguracja <span class="kv m">wpisów: {{ config.count }}</span></summary>
  <div class="scroll"><table class="stack cfgt">
   <thead><tr><th>Klucz</th><th>Wartość</th><th>Znaczenie</th><th>Używany w</th></tr></thead>
   <tbody>
{%- for group in config.groups %}
    <tr class="csec"><td colspan="4">{{ group.label }}</td></tr>
{%- for entry in group.entries %}
{{ config_row(entry) }}
{%- endfor %}
{%- endfor %}
   </tbody>
  </table></div>
 </details>
{%- endmacro -%}

{%- macro tree_marker(marker) -%}
{%- if marker %}<i class="mk{% if marker != "code" %} {{ marker }}{% endif %}"></i>{% endif -%}
{%- endmacro -%}

{%- macro tree_nodes(children) -%}
 <ul class="tr">
{%- for node in children %}
  <li><button class="it{% if node.is_dir %} dir{% endif %}" data-w="{{ node.what }}" data-r="{{ node.role_text }}">{{ tree_marker(node.marker) }}{{ node.name }}</button>
{%- if node.children %}
{{ tree_nodes(node.children) }}
{%- endif %}</li>
{%- endfor %}
 </ul>
{%- endmacro -%}

{%- macro block_tree(tree) -%}
 <div class="legend">
  <span><i class="mk fill"></i>punkt wejścia</span>
  <span><i class="mk"></i>kod robota</span>
  <span><i class="mk cfg"></i>konfiguracja</span>
  <span><i class="mk sec"></i>sekret: tylko metadane</span>
 </div>
{%- if tree.skipped_count %}
 <p class="note">Pominięto {{ tree.skipped_count }} plików frameworku skopiowanego do projektu ({{ tree.skipped_frameworks | join(", ") }}).</p>
{%- endif %}
 <div class="grp">
  <button class="it dir" data-w="{{ tree.root.what }}" data-r="{{ tree.root.role_text }}">{{ tree.root.name }}</button>
{{ tree_nodes(tree.children) }}
 </div>
{%- endmacro -%}

{%- macro block_flow(flow) -%}
{%- if flow.problems %}
 <p class="note">Diagram nie przeszedł sprawdzenia spójności i nie został narysowany:</p>
 <ul class="ul">
{%- for problem in flow.problems %}
  <li>{{ problem }}</li>
{%- endfor %}
 </ul>
{%- else %}
 <div class="legend">
  <span><i class="mk rnd"></i>start / koniec</span>
  <span><i class="mk"></i>czynność robota</span>
  <span><i class="mk fill"></i>kontakt z systemem zewnętrznym</span>
  <span><i class="mk dia"></i>decyzja</span>
  <span><i class="mk loop"></i>powrót pętli</span>
 </div>
 <div class="fig" id="flowfig"><svg id="flow" role="img" aria-label="Diagram przepływu procesu robota"></svg></div>
 <p class="note">Układ (wiersze, kolumny, pętle) wylicza kod z grafu kroków zwróconego przez model i sprawdzonego pod kątem spójności.</p>

 <h2>Krok po kroku</h2>
 <div class="legend">
  <span><span class="c f" style="padding:1px 8px">plik</span></span>
  <span><span class="c env" style="padding:1px 8px">zmienna środ.</span></span>
  <span><span class="c sys" style="padding:1px 8px">system zewn.</span></span>
  <span><span class="c" style="padding:1px 8px">dane w pamięci</span></span>
 </div>
 <div class="fhead"><span>czyta</span><span>co się dzieje</span><span>zapisuje / zwraca</span></div>
 <div id="flowrows"></div>
{%- endif %}
{%- endmacro -%}

{%- macro block_deps(graph) -%}
 <p class="note">Wyliczone z importów, bez modelu. Strzałka: moduł importuje moduł.</p>
 <div class="legend">
  <span><i class="mk fill"></i>punkt wejścia</span>
  <span><i class="mk"></i>moduł robota</span>
 </div>
 <div class="depfig"><svg id="deps" role="img" aria-label="Graf zależności modułów"></svg></div>
{%- if graph.isolated_count %}
 <p class="note">Pliki bez powiązań z innymi plikami robota: {{ graph.isolated_count }} ({% for path in graph.isolated %}<code>{{ path }}</code>{% if not loop.last %}, {% endif %}{% endfor %}{% if graph.isolated_count > graph.isolated | length %} i {{ graph.isolated_count - graph.isolated | length }} innych{% endif %}).</p>
{%- endif %}
{%- endmacro -%}

{%- macro block_reading(reading) -%}
 <p class="note">Kolejność wyliczona z importów (od punktu wejścia w głąb).{% if reading.has_reasons %} Zdanie przy pliku wyjaśnia, dlaczego czytać go w tym miejscu.{% endif %}</p>
 <ol class="road">
{%- for item in reading.entries %}
{%- if item.path %}
  <li><b><code>{{ item.path }}</code></b>{% if item.text %}<span>{{ item.text | terms }}</span>{% endif %}</li>
{%- else %}
  <li><span>{{ item.text | terms }}</span></li>
{%- endif %}
{%- endfor %}
 </ol>
{%- endmacro -%}

{%- macro block_cards(cards) -%}
 <p class="note">Zacznij od tej zakładki: po niej uruchomisz robota. Potem diagram przepływu: po nim opowiesz, co robot robi. Resztę czytaj, gdy masz konkretne zadanie.</p>
 <div class="cards">
{%- for card in cards %}
  <a href="#{{ card.id }}"><em>{{ card.label }}</em><b>{{ card.title }}</b><span>{{ card.text }}</span></a>
{%- endfor %}
 </div>
{%- endmacro -%}

<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ project_name }} - przewodnik dla dewelopera</title>
<style>
{{ css | safe }}
</style>
</head>
<body>
<aside>
 <div class="brand">{{ project_name }}</div>
 <div class="sub">Przewodnik dla dewelopera</div>
 <nav id="nav">
{%- for tab in nav %}
  <a href="#{{ tab.id }}"><i></i>{{ tab.title }}</a>
{%- endfor %}
 </nav>
 <div class="meta">
  <p>Wygenerowano: {{ generated_at }} przez dev-agents.</p>
  <p>Projekt: <code>{{ project_root }}</code></p>
  <p>Oznaczenie <span class="unc">wywnioskowane</span> = informacja wynika z analizy kodu, ale nie jest w nim zapisana wprost. Sprawdź przed poleganiem na niej.</p>
 </div>
</aside>

<main>
<div id="tip" hidden></div>
{% for tab in tabs %}
<section class="tab" id="{{ tab.id }}"{% if not loop.first %} hidden{% endif %}>
 <h1>{{ tab.heading }}</h1>
{%- for paragraph in tab.lead %}
 <p class="lead">{{ paragraph | terms }}</p>
{%- endfor %}
{% for section in tab.sections %}
{%- if section.type != "flow" %}
 <h2 id="s-{{ section.id }}">{{ section.title }}</h2>
{%- endif %}
{%- if section.state == "missing" %}
 <p class="note">{{ section.missing_text }}</p>
{%- elif section.state == "pending" %}
 <p class="note"><span class="ph">[blok typu {{ section.type }}: dochodzi w kolejnym kroku planu]</span></p>
{%- elif section.type == "text" %}
{{ block_text(section.block) }}
{%- elif section.type == "list" and section.reading %}
{{ block_reading(section.reading) }}
{%- elif section.type == "list" %}
{{ block_list(section.block) }}
{%- elif section.type == "io" %}
{{ block_io(section.block, project_name, technology_line) }}
{%- elif section.type == "cards" %}
{{ block_cards(cards) }}
{%- elif section.type == "steps" %}
{{ block_steps(section.block) }}
{%- elif section.type == "code" %}
 {{ code_box(section.code_text) }}
{%- elif section.type == "tree" %}
{{ block_tree(section.tree) }}
{%- elif section.type == "flow" %}
{{ block_flow(section.flow) }}
{%- elif section.type == "dependency_graph" %}
{{ block_deps(section.graph) }}
{%- elif section.type == "table" %}
{{ block_table(section.columns, section.rows) }}
{%- elif section.type == "glossary" %}
{{ block_glossary(section.block) }}
{%- elif section.type == "paths" %}
{{ block_paths(section.block, node_numbers, path_kind_labels) }}
{%- elif section.type == "recipes" %}
{{ block_recipes(section.block) }}
{%- elif section.type == "config" %}
{{ block_config(section.config) }}
{%- endif %}
{% endfor %}
</section>
{% endfor %}
</main>

{%- for tab in tabs %}{% for section in tab.sections %}{% if section.type == "flow" and section.flow and section.flow.data %}
<script type="application/json" id="flow-data">{{ section.flow.data | tojson }}</script>
{%- endif %}{% if section.type == "dependency_graph" and section.graph and section.graph.data %}
<script type="application/json" id="deps-data">{{ section.graph.data | tojson }}</script>
{%- endif %}{% endfor %}{% endfor %}
<script>
{{ js | safe }}
</script>
</body>
</html>
